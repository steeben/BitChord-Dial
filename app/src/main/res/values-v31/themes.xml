<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ always shows a splash screen of its own: here the squares logo
      building itself square by square, held until Home is ready (see LaunchGate)
      and then swept off the app with the logo still lit (LaunchWipeView).

      It follows the app's theme: black squares on white in the light theme,
      white on black in the dark one. This file is the light one for a phone in
      light mode, values-night-v31 the dark one. On Android 13 and up the app
      picks Theme.BitChord.SplashLight or SplashDark itself from its own theme
      setting (SplashTheme.kt), since that can differ from the phone's.
    -->
    <style name="Theme.BitChord" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo_light</item>
        <item name="android:windowSplashScreenAnimationDuration">1040</item>
    </style>

    <style name="Theme.BitChord.SplashLight">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo_light</item>
        <item name="android:windowSplashScreenAnimationDuration">1040</item>
    </style>

    <style name="Theme.BitChord.SplashDark">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">1040</item>
    </style>
</resources>
