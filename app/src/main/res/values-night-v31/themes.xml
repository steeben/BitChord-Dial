<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The dark splash: white squares on black. See values-v31/themes.xml, which
      also holds Theme.BitChord.SplashLight and SplashDark.
    -->
    <style name="Theme.BitChord" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">1040</item>
    </style>
</resources>
